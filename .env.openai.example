# 선택형 openai API. 구독 로그인과 별도 과금이며 키는 서버에만 저장합니다.
SERVER_TOKEN=
MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=
STT_PROVIDER=local
STT_URL=http://127.0.0.1:8790
HOST=127.0.0.1
LAN_HOST=
PORT=8789
# 음성도 외부로 보내려면 STT_PROVIDER=openai와 실제 음성 모델 ID를 지정합니다.
TRANSCRIPTION_MODEL=
# 별도 과금 사용을 결정한 경우에만 true로 바꿉니다.
ALLOW_PAID_API=false
WHISPER_MODEL=large-v3-turbo
WHISPER_CPU_THREADS=4
