# 일반 사용자 예제. 실제 .env·접속 토큰·로그인 정보를 GitHub에 올리지 않습니다.
SERVER_TOKEN=
MODE=codex
# 예시입니다. 계정의 CLI가 지원하는 실제 모델 ID로 확인·변경합니다.
CODEX_MODEL=gpt-5.6-sol
# 로그인과 같은 절대 경로를 입력합니다. ~ 또는 $HOME은 자동 확장되지 않습니다.
CODEX_HOME=
STT_PROVIDER=local
STT_URL=http://127.0.0.1:8790
HOST=127.0.0.1
# PC의 신뢰하는 사설망 접속을 쓸 때만 자신의 서버 내부 IP를 입력합니다.
LAN_HOST=
PORT=8789
ALLOW_PAID_API=false
WHISPER_MODEL=large-v3-turbo
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=5
# 선택 사항: 회사명·고유명사·전문용어 힌트. 원문 치환 명령을 넣지 않습니다.
WHISPER_HOTWORDS=
WHISPER_INITIAL_PROMPT=

# 선택: 빠른 모드가 필요하면 한국어 지원 small 모델 ID 또는 준비한 모델 경로를 지정합니다.
# 비워 두면 터보 구간 전사만 제공하며 정밀 모델은 그대로 유지됩니다.
WHISPER_FAST_MODEL=
WHISPER_FAST_BEAM_SIZE=1
