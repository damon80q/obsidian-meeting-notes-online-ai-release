# 선택형 anthropic API. 구독 로그인과 별도 과금이며 키는 서버에만 저장합니다.
SERVER_TOKEN=
MODE=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
STT_PROVIDER=local
STT_URL=http://127.0.0.1:8790
HOST=127.0.0.1
LAN_HOST=
PORT=8789
# 별도 과금 사용을 결정한 경우에만 true로 바꿉니다.
ALLOW_PAID_API=false
WHISPER_MODEL=large-v3-turbo
WHISPER_CPU_THREADS=4

# 선택: 빠른 모드가 필요하면 한국어 지원 small 모델 ID 또는 준비한 모델 경로를 지정합니다.
# 비워 두면 터보 구간 전사만 제공하며 정밀 모델은 그대로 유지됩니다.
WHISPER_FAST_MODEL=
WHISPER_FAST_BEAM_SIZE=1
